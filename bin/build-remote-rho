#!/usr/bin/env bun
/**
 * rho as a package a host can load without bun.
 *
 * The agent on another machine should be this agent: the same tools, the same
 * prompt, the same rules. Sending the source does not achieve that, because
 * rho is typescript and the pi that runs there runs under node, which cannot
 * load it. A host's own bun is not a way round it either: robotics-vm's is too
 * old for this pi, and the official build will not run on NixOS at all.
 *
 * So the extensions are built here, where bun is, into plain javascript with
 * pi's own modules left external, and the resources they read travel beside
 * them. The result is a directory pi can be pointed at by `packages`.
 */

import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { $ } from 'bun';

interface Manifest {
    version?: string;
    pi?: { extensions?: string[]; skills?: string[]; prompts?: string[]; themes?: string[] };
}

const manifestOf = (dir: string): Manifest => JSON.parse(readFileSync(join(dir, 'package.json'), 'utf8')) as Manifest;

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const out = process.argv[2] ?? join(root, 'build', 'remote-rho');

/** pi's own modules come from the pi that loads this, never from a copy. */
const EXTERNAL = ['@earendil-works/*', '@mariozechner/*'];

/**
 * Left out of the remote package.
 *
 * bun-runtime.ts exists to force this process to be bun, by re-running pi
 * under whatever bun the machine has. On a host whose bun is older than this
 * pi that is a crash rather than a repair, and the reason the extensions are
 * built to javascript is that node is what will load them there.
 */
const WITHOUT = ['bun-runtime'];

/**
 * Nothing is left out for size.
 *
 * Measuring one package on top of a bare pi suggested pi-rewind cost 46 MB and
 * pi-web-access 39 MB, so leaving one out should have paid. Taking pi-rewind
 * out of the whole set moved a session from 165 MB to 167 MB: they share their
 * dependencies, and what each costs alone is not what it costs alongside the
 * others. The code is loaded either way.
 */
const VENDOR_WITHOUT: readonly string[] = [];

/** what an extension reads at runtime, beside the code that reads it. */
const RESOURCES = ['skills', 'prompts', 'themes', 'system', 'rho.toml', 'maxims.txt'];

rmSync(out, { recursive: true, force: true });
mkdirSync(join(out, 'extensions'), { recursive: true });

/**
 * Split, so the forty extensions share one copy of what they share.
 *
 * Bundled one at a time they each carry their own copy of pi-tui, typebox and
 * every library rho uses: nine megabytes of javascript that a session parses
 * forty times over. Measured on robotics-vm, pi with rho held 177 MB against a
 * bare pi's 91 MB, and that difference is mostly the duplication.
 *
 * The entry points land in extensions/ and the shared chunks beside them in the
 * package root, which pi does not scan, so it loads the extensions and they
 * pull in what they need.
 */
const built = await $`bun build ${join(root, 'extensions')}/*.ts --target=node --outdir ${out} --splitting ${EXTERNAL.flatMap((name) => ['--external', name])}`.quiet();
if (built.exitCode !== 0) {
    process.stderr.write(built.stderr.toString());
    process.exit(1);
}

// bun keeps the entry points' directory, so they land under extensions/
// whichever way the build is shaped; a nested copy from an older layout is
// flattened first.
const nested = join(out, 'extensions', 'extensions');
if (existsSync(nested)) {
    cpSync(nested, join(out, 'extensions'), { recursive: true });
    rmSync(nested, { recursive: true, force: true });
}

// Removed after the build, not before, and from wherever they landed: this
// used to name one layout, and the split build put the files somewhere else,
// so the bun relauncher survived and took pi with it.
for (const name of WITHOUT) {
    for (const place of [join(out, 'extensions', `${name}.js`), join(out, 'extensions', 'extensions', `${name}.js`)]) {
        rmSync(place, { force: true });
    }
}

/**
 * The extensions rho loads from packages, built the same way.
 *
 * They are declared in rho's own package.json, and two of them are typescript,
 * so a host loading this with node needs them built as well. Each is bundled
 * under a name that says where it came from.
 */
const vendored = (manifestOf(root).pi?.extensions ?? []).filter((entry) => entry !== './extensions');
const kept: string[] = ['./extensions'];
for (const entry of vendored) {
    const from = join(root, entry);
    if (!existsSync(from)) continue;
    if (VENDOR_WITHOUT.some((name) => entry.includes(name))) continue;
    const name = `vendor-${entry.split('/').filter((part) => part !== '' && part !== 'node_modules').slice(0, 2).join('-').replace(/[^A-Za-z0-9._-]/g, '-')}.js`;
    const one = await $`bun build ${from} --target=node --outfile ${join(out, 'extensions', name)} ${EXTERNAL.flatMap((external) => ['--external', external])}`.quiet().nothrow();
    if (one.exitCode === 0) kept.push(`./extensions/${name}`);
    else process.stderr.write(`left out ${entry}: it does not bundle\n`);
}

// Assets an extension reads by path rather than by import.
// Assets go beside the extensions and beside the shared chunks: a split build
// resolves a path relative to whichever file is asking, and the chunks sit a
// directory above the extensions.
const assets = join(root, 'extensions', 'assets');
if (existsSync(assets)) {
    cpSync(assets, join(out, 'extensions', 'assets'), { recursive: true });
    cpSync(assets, join(out, 'assets'), { recursive: true });
}
for (const name of RESOURCES) {
    const from = join(root, name);
    if (existsSync(from)) cpSync(from, join(out, name), { recursive: true });
}

/**
 * Skills and prompts that come from packages, brought along too.
 *
 * Nine of rho's skills live in the packages it depends on, and a remote agent
 * without them is missing a third of what it can be asked to do. They are
 * copied under the directory that already holds rho's own.
 */
const gathered = (kind: 'skills' | 'prompts' | 'themes'): void => {
    for (const entry of manifestOf(root).pi?.[kind] ?? []) {
        if (entry.startsWith('./')) continue;
        const from = join(root, entry);
        if (!existsSync(from)) continue;
        for (const skill of readdirSync(from)) {
            const target = join(out, kind, skill);
            if (existsSync(target)) continue;
            cpSync(join(from, skill), target, { recursive: true });
        }
    }
};
for (const kind of ['skills', 'prompts', 'themes'] as const) gathered(kind);



writeFileSync(
    join(out, 'package.json'),
    `${JSON.stringify(
        {
            name: 'rho-remote-agent',
            version: manifestOf(root).version ?? '0.0.0',
            type: 'module',
            private: true,
            pi: {
                extensions: ['./extensions'],
                skills: existsSync(join(out, 'skills')) ? ['./skills'] : undefined,
                prompts: existsSync(join(out, 'prompts')) ? ['./prompts'] : undefined,
                themes: existsSync(join(out, 'themes')) ? ['./themes'] : undefined,
            },
        },
        null,
        2,
    )}\n`,
);

process.stdout.write(`${out}\n`);
