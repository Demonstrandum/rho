#!/usr/bin/env bun
/**
 * rho-remote <user@host> <session> — pi's interface, here, for a session there.
 *
 * The session runs as a daemon on the far side, reached over ssh. This draws it
 * with pi's own interface: the same renderer, the same rows, the same
 * streaming, because it is the same code reading the same events. The wire is
 * the only thing added.
 *
 * Not an extension, because the interface is the thing being replaced: an
 * extension can only add to a session that already exists, and drawing another
 * session's events inside one produces a log rather than an interface.
 */

import {
    AgentSessionRuntime,
    InteractiveMode,
    SessionManager,
    createAgentSessionFromServices,
    createAgentSessionServices,
} from '@earendil-works/pi-coding-agent';
import { spawn } from 'node:child_process';
import { existsSync, readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { RpcLink } from '../extensions/lib/remote/rpc-link';
import { RemoteActions, RemoteState } from '../extensions/lib/remote/proxy-session';
import { remoteSession } from '../extensions/lib/remote/remote-session';
import { UiRelay, asUiRequest, isAnswerable, publishRelay, unanswerable } from '../extensions/lib/remote/ui-relay';
import { config } from '../extensions/lib/config';
import { TurnGate } from '../extensions/lib/remote/turn-gate';
import { controlPath } from '../extensions/lib/remote/agent-tag';
import { troubleWith } from '../extensions/lib/remote/advice';
import { PassThrough } from 'node:stream';
import { serve as serveExecutor } from '../extensions/lib/remote/executor';
import { pack as packOrigin, readLines as readOriginLines, unpack as unpackOrigin } from '../extensions/lib/remote/origin-channel';

const [target, name, ...rest] = process.argv.slice(2);
// A message given on the command line is submitted on attach, which is how a
// session is driven without a person at the keyboard.
const opening = rest.join(' ').trim();
if (target === undefined || name === undefined) {
    process.stderr.write('usage: rho-remote <user@host> <session>\n');
    process.exit(1);
}

const CACHE = `${process.env.HOME ?? '/tmp'}/.cache/rho/remote`;

const SSH_FLAGS = [
    // The handshake to a machine like this costs seconds; the connection is
    // shared with everything else rho opens, so attaching a second time pays
    // for the socket and not the handshake.
    '-o',
    'ControlMaster=auto',
    '-o',
    `ControlPath=${controlPath(CACHE)}`,
    '-o',
    'ControlPersist=10m',
    '-o',
    'ClearAllForwardings=yes',
    '-o',
    'LogLevel=ERROR',
    '-o',
    'ConnectTimeout=10',
    '-o',
    'BatchMode=yes',
];
const RUNNER_FILE = '.cache/rho/remote/session-runner.js';
const RUNNER = process.env.RHO_REMOTE_RUNNER ?? `bun ${RUNNER_FILE}`;

/**
 * A session on this machine needs no ssh at all.
 *
 * Detaching locally is the same thing as a remote session with the network
 * taken out: the agent runs behind a socket here, and the interface attaches
 * to it. "local" as the machine means run the runner directly.
 */
const here = target === 'local';
const runnerHere = `${process.env.HOME ?? ''}/${RUNNER_FILE}`;
const speak = (verb: string, extra: readonly string[] = []): { command: string; args: string[] } =>
    here
        ? { command: 'bun', args: [runnerHere, ...verb.split(' ')] }
        : { command: process.env.RHO_REMOTE_SSH ?? 'ssh', args: [...SSH_FLAGS, ...extra, target, `${RUNNER} ${verb}`] };

/** One ssh call, answered when it is answered. */
const ask = (command: string, input?: string): Promise<{ code: number; out: string; err: string }> =>
    new Promise((settle) => {
        const child = spawn('ssh', [...SSH_FLAGS, target, command], { stdio: ['pipe', 'pipe', 'pipe'] });
        let out = '';
        let err = '';
        child.stdout.on('data', (chunk: Buffer) => (out += chunk.toString()));
        child.stderr.on('data', (chunk: Buffer) => (err += chunk.toString()));
        child.on('close', (code) => settle({ code: code ?? 1, out, err }));
        child.on('error', (error) => settle({ code: 1, out, err: error.message }));
        if (input !== undefined) child.stdin.end(input);
        else child.stdin.end();
    });

/**
 * Hand the far side credentials as fresh as this machine's, before attaching.
 *
 * An OAuth token lasts hours and its refresh token is single use, so the copy
 * lent when the session started goes stale the moment this machine refreshes
 * its own. The far side then answers with an empty message and the refusal
 * buried inside it, which reads as the model having nothing to say.
 */
const relend = async (): Promise<void> => {
    // A session here reads the same auth.json this process does.
    if (process.env.RHO_REMOTE_SSH !== undefined || here) return;
    const authPath = join(homedir(), '.pi', 'agent', 'auth.json');
    if (!existsSync(authPath)) return;
    const sent = await ask(`${RUNNER} relend ${name}`, JSON.stringify({ auth: readFileSync(authPath, 'utf8') }));
    if (sent.code !== 0 && !/no credentials of its own/.test(sent.err)) {
        process.stderr.write(`could not refresh the credentials on ${target}: ${sent.err.trim()}\n`);
    }
};

// Started, not awaited: the credentials have to be there before a prompt, not
// before the interface draws, and the far side is a round trip away.
const credentials = relend();

/** Said once the interface has given the terminal back, not over the top of it. */
let farewell: string | null = null;
let drawing: { stop: () => void } | null = null;

/**
 * Which machine this is, published before anything local is loaded.
 *
 * The footer, /cwd and the extensions read this to know the work is not
 * happening here, and an extension factory runs while services are being
 * built: publishing it afterwards meant they were all told they were local.
 * The directory arrives a round trip later and is filled in then.
 */
const where: { name: string; host: string; cwd: string; branch: string | null; shell: string; alive: boolean; chdir: (path: string) => Promise<string> } = {
    name: target,
    host: target.includes('@') ? target.slice(target.indexOf('@') + 1) : target,
    cwd: process.cwd(),
    branch: null,
    shell: 'bash',
    alive: true,
    chdir: async (path: string) => {
        const answer = (await actions.bash(`cd ${path} && pwd`)) as { data?: { output?: string } };
        const landed = (answer.data?.output ?? '').trim();
        if (landed !== '') where.cwd = landed;
        return landed;
    },
};
(globalThis as Record<string, unknown>).__rho_environment = where;

/**
 * The session's user interface, which has to be somewhere.
 *
 * A session running as a daemon is `pi --mode rpc`, and rpc mode draws nothing:
 * every `ctx.ui` call there leaves as a frame and is answered with a frame. The
 * relay is published before pi loads anything, because the extension that draws
 * these requests looks for it while it is being constructed.
 */
const relay = new UiRelay((frame) => link.tell(frame));
publishRelay(relay);

/**
 * The interface's own half, built while the far side is being asked.
 *
 * None of this needs an answer from the other machine: the settings, the
 * theme, the editor and the extensions are this machine's, and loading pi
 * takes about as long as the round trips do.
 */
const local = (async () => {
    const services = await createAgentSessionServices({ cwd: process.cwd() });
    return services;
})();

// RHO_REMOTE_SSH replaces the transport, so the client can be driven against a
// stand-in daemon on this machine. Nothing else changes: same framing, same
// proxy, same interface.
const attaching = speak(`attach ${name}`);

const link = new RpcLink(attaching.command, attaching.args, {
    // No deadline on the link: a model call takes as long as it takes, and the
    // interface shows that it is working. A link that has died says so by
    // closing, which is a different thing from an answer that is slow.
    timeoutMs: 0,
    onClosed: (why) => {
        // The interface owns the terminal: writing over it leaves the screen
        // half drawn and the cursor wherever the last frame put it. It is
        // stopped first, and then the reason is said on a clean line.
        // The reason and the one thing worth doing about it, so a client that
        // stops says what stopped it rather than vanishing.
        const trouble = troubleWith(why, name, target);
        farewell = `${name} on ${target}: ${trouble.reason}${trouble.advice === null ? '' : `\n${trouble.advice}`}`;
        if (drawing === null) {
            process.stderr.write(`\n${farewell}\n`);
            process.exit(1);
        }
        // Stopping restores the terminal; leaving it at that does not end the
        // process, because the interface is waiting on input that will never
        // come. A session whose far side has gone must not keep drawing as
        // though it were still there, so the exit is not left to chance.
        drawing.stop();
        setTimeout(() => {
            process.stderr.write(`${farewell}\n`);
            process.exit(1);
        }, 150).unref?.();
    },
});

/**
 * Everything the session says that is not the conversation.
 *
 * A request to draw something goes to the relay, which hands it to the
 * extension holding this interface's `ctx.ui`. A method this build does not
 * know is cancelled rather than ignored, since an unanswered dialog parks the
 * extension that opened it. An extension that threw, and anything the far side
 * wrote to stderr, are said here too: both used to travel the whole way across
 * the link and then be dropped on arrival.
 */
link.onEvent((event) => {
    const request = asUiRequest(event);
    if (request !== null) {
        // With the relay turned off nothing here can draw, and a dialog left
        // unanswered parks the extension that opened it for as long as the
        // session lives. Cancelling is the truthful answer: there is no
        // interface for this.
        if (!config.remote.relayUi) {
            if (isAnswerable(request.method)) relay.cancel(request.id);
            return;
        }
        relay.deliver(request);
        return;
    }
    const unknown = unanswerable(event);
    if (unknown !== null) {
        relay.cancel(unknown);
        relay.say(`the session asked for something this interface cannot draw (${String((event as { method?: unknown }).method)})`, 'warning');
        return;
    }
    if (event.type === 'extension_error') {
        const where = typeof event.extensionPath === 'string' ? event.extensionPath : 'an extension';
        const what = typeof event.error === 'string' ? event.error : 'failed';
        relay.say(`${where}: ${what}`, 'error');
        return;
    }
    if (event.type === 'rho_stderr' && typeof event.text === 'string') {
        relay.say(event.text, 'warning');
        return;
    }
    /**
     * The session asking this interface to leave.
     *
     * The same exit ctrl+d takes, decided on the other side: the flag says the
     * agent stays behind its socket, the terminal is given back, and the
     * interface that spawned this one carries the conversation home.
     */
    if (event.type === 'rho_leave') {
        (globalThis as { __rho_detaching?: boolean }).__rho_detaching = true;
        if (drawing !== null) drawing.stop();
        process.stdout.write(`${name} asked this interface to leave. it is still running on ${target}.\n`);
        process.exit(0);
    }
});

// RHO_REMOTE_LOG names a file to write every event type to, which is the only
// way to see what a terminal interface received without being the terminal.
const trace = process.env.RHO_REMOTE_LOG;
if (trace !== undefined) {
    const { appendFileSync } = await import('node:fs');
    link.onEvent((event) => appendFileSync(trace, `${event.type}\n`));
}

/**
 * This machine, offered to the session while this interface is attached.
 *
 * Work that can only happen where the person is -- nodes reads the Tailscale
 * identity of whoever opens the connection -- runs here, over the connection
 * that is already carrying prompts one way and events the other. The far side
 * opens a channel on its own session socket, the broker pairs it with this
 * client, and the executor runs in this process.
 *
 * An ssh forward was the first attempt and does not work on OpenSSH 10.5: a
 * forwarded unix socket is created root-owned with mode 0600 whatever
 * StreamLocalBindMask says, so the account running the session cannot open it.
 */
const originIn = new PassThrough();
const originOut = new PassThrough();
serveExecutor(originIn, originOut);
// tell, not send: an origin frame is one direction of a stream and has no
// reply of its own, so waiting for one would time out every chunk.
originOut.on('data', (chunk: Buffer) => link.tell(packOrigin(new Uint8Array(chunk))));
link.onEvent((event) => {
    if ((event as { type?: string }).type !== 'rho_origin') return;
    const bytes = unpackOrigin(event as { payload?: unknown });
    if (bytes !== null) originIn.write(Buffer.from(bytes));
});

const state = new RemoteState(link);
const actions = new RemoteActions(link);
if (trace !== undefined) {
    const { appendFileSync } = await import('node:fs');
    // what the session hands the interface, as opposed to what the wire carried
    state.subscribe((event) => appendFileSync(trace, `session:${(event as { type: string }).type}\n`));
}
/**
 * Everything the far side is asked before drawing, asked at once.
 *
 * These were sequential, and each one is a round trip to another machine: the
 * state, the messages and where the session is came to about a second between
 * them, on top of a local build that could have been happening at the same
 * time.
 */
const [info] = await Promise.all([
    link.send({ type: 'rho_info' }).catch(() => ({})) as Promise<{
        data?: { cwd?: string; branch?: string | null };
    }>,
    state.refresh(),
    credentials,
    local,
]);

/**
 * Where the session is, asked of the broker rather than the agent.
 *
 * The interface shows a working directory and resolves paths against it. Left
 * as this machine's, it shows the directory the client was started from, which
 * is not where anything the session does happens: the footer said ~/Code/rho
 * for a session working in /home/nix.
 */
const remoteCwd = info.data?.cwd ?? process.cwd();

// The directory and its branch, now that the far side has said both.
where.cwd = remoteCwd;
where.branch = info.data?.branch ?? null;

// The local half: settings, the editor, the renderer, and a session file of
// this machine's own. None of it is the agent; all of it is the interface.
//
// Built against this machine's directory, not the far side's. Pointing it at a
// path that exists only there made everything local reach for a directory that
// is not here: pi's own checkpointing failed with ENOENT on every turn. Where
// the session is belongs to the environment marker, which is what the footer
// and /cwd read.
const services = await local;
const sessionManager = SessionManager.inMemory(process.cwd());
const made = await createAgentSessionFromServices({ services, sessionManager });

/**
 * What was said before this client arrived.
 *
 * The interface builds its opening transcript from the local session manager,
 * which for a client that has just started is empty: reattaching to a session
 * with an afternoon of work in it showed a blank screen, and the work was
 * still there but invisible. The far side's messages are put in, so the first
 * thing drawn is the conversation as it stands.
 */
for (const message of state.messages) {
    try {
        sessionManager.appendMessage(message as never);
    } catch {
        // A message shape this build does not know is better skipped than
        // fatal: the rest of the history is still worth drawing.
    }
}

/**
 * Let the extensions see the far side's turn as a turn.
 *
 * The interface draws from session events, but everything around it is fed by
 * extension events, which are raised by the session running the agent -- here,
 * a session on another machine. Without this the working indicator has no
 * message and draws as a blank line, so an answer that takes minutes is
 * indistinguishable from a hang. One turn took five minutes and the screen did
 * not move once.
 *
 * The mapping from agent event to extension event is pi's own, reused rather
 * than copied, because a second copy of it would drift. What must not follow
 * from this is local work on a remote turn: the checkpoint guard reads the
 * environment marker and stands down.
 */
const raise = (made.session as unknown as { _emitExtensionEvent?: (event: unknown) => Promise<void> })
    ._emitExtensionEvent;
if (typeof raise === 'function') {
    // Whole turns only: a client can attach in the middle of one, and an end
    // without a beginning makes anything that measures a turn measure from
    // nothing. See lib/remote/turn-gate.ts.
    const gate = new TurnGate();
    // Attaching to a session that is already answering: the turn on screen is
    // one this client walked in on, so extensions are told about the next one
    // instead of half of this one. The rows still stream, because the
    // interface draws from the session's events and not from these.
    if (state.state.isStreaming === true) {
        gate.join();
        relay.say('joined a turn that was already running: the working indicator starts with the next one', 'info');
    }
    state.subscribe((event) => {
        if (!gate.admits((event as { type: string }).type)) return;
        void raise.call(made.session, event).catch(() => {
            // An extension that throws on a remote turn is not a reason to stop
            // drawing one.
        });
    });
}

// A refusal is shown rather than thrown: the interface asks some of these from
// a keystroke handler, where an exception ends the client. It went to stderr,
// which the interface is drawing over, so nobody ever read one.
state.onRefusal((what) => relay.say(what, 'warning'));

const proxied = remoteSession(made.session as unknown as Record<string, unknown>, link, state, actions, {
    say: (message, level) => relay.say(message, level),
    keepHere: new Set(config.remote.commandsHere),
});

const runtime = new AgentSessionRuntime(
    proxied as never,
    services,
    // A replacement session would be a different remote session; until
    // /remote can switch between them, the factory hands back this one.
    async () => ({ session: proxied as never, services, diagnostics: [] }),
    [],
);

// Extensions in this process are drawing an interface onto a session that is
// already running on its own: rho reads this to tell the two apart.
process.env.RHO_REMOTE_CLIENT = '1';

const interactive = new InteractiveMode(runtime, {
    initialMessage: opening === '' ? undefined : opening,
    verbose: false,
});

/**
 * The same terminal a local session gets.
 *
 * This drew on the alternate screen, so that leaving it restored the session
 * underneath. That screen has no scrollback, and a terminal in it turns the
 * wheel into arrow keys, which the editor reads as walking back through the
 * prompt history: scrolling changed what was typed. pi does not put a session
 * there and neither does this.
 *
 * What is left of the overlay is the clear: the remote session starts at the
 * top of the screen rather than under the local one's transcript, and the
 * interface that launched it redraws itself when this exits.
 */
if (process.stdout.isTTY === true) process.stdout.write('\u001b[2J\u001b[H');

drawing = interactive;
await interactive.run();

/**
 * Leaving ends the session; detaching leaves it running.
 *
 * That is the distinction tmux was standing in for, and it has to hold on both
 * sides of it: /exit and ctrl+c twice stop the agent, ctrl+d sets the flag
 * below and the agent stays behind its socket for the next attach. Without
 * this, every interface that was ever closed left an agent resident, which is
 * how eight of them came to be sharing a machine with 912 MB of memory.
 */
const detaching = (globalThis as { __rho_detaching?: boolean }).__rho_detaching === true;
if (!detaching) {
    try {
        await new RemoteActions(link).stopSession();
    } catch {
        // An agent that has already gone needs no stopping, and the interface
        // is on its way out either way.
    }
}

// The interface is done with the terminal, so this process is done too. The
// link holds an ssh child that keeps the event loop alive on its own: leaving
// it means the interface says goodbye and the shell never comes back.
link.stop();
if (farewell !== null) {
    process.stderr.write(`${farewell}\n`);
    process.exit(1);
}
process.exit(0);
