#!/usr/bin/env bun
/**
 * Holds a Slack Socket Mode connection and spools every message to a file.
 *
 * The socket is a live connection, so something has to stay resident to own it.
 * This does, independently of pi: a message that arrives while no session is
 * open lands in the spool and is read the moment one starts. The rho extension
 * slack-inbox.ts watches the same file and injects new lines into a running
 * session.
 *
 * Credentials come from files, never from the environment or a store path:
 *   ~/.config/robotics-migration/slack-app-token   xapp-, connections:write
 *   ~/.config/robotics-migration/slack-ids         name=ID lines, for labelling
 *
 * Spool lines are JSON: { ts, channel, user, name, text }.
 */

import { appendFileSync, readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const CONFIG = join(homedir(), '.config', 'robotics-migration');
const SPOOL = join(CONFIG, 'slack-inbox.jsonl');

const read = (name: string): string =>
    readFileSync(join(CONFIG, name), 'utf8').trim();

/** name=ID pairs, so a spooled message says "adam" rather than U09L8EEPUTC. */
const names = (): Map<string, string> => {
    const out = new Map<string, string>();
    try {
        for (const line of read('slack-ids').split('\n')) {
            const [k, v] = line.split('=');
            if (k && v) out.set(v.trim(), k.trim());
        }
    } catch {
        // labelling is optional
    }
    return out;
};

interface SlackEvent {
    type: string;
    user?: string;
    bot_id?: string;
    channel?: string;
    text?: string;
    ts?: string;
    thread_ts?: string;
    subtype?: string;
}

interface Frame {
    type?: string;
    envelope_id?: string;
    payload?: { event?: SlackEvent };
    connection_info?: { app_id?: string };
}

const label = names();
const appToken = read('slack-app-token');

async function connect(): Promise<void> {
    const res = await fetch('https://slack.com/api/apps.connections.open', {
        method: 'POST',
        headers: { Authorization: `Bearer ${appToken}` },
    });
    const body = (await res.json()) as { ok: boolean; url?: string; error?: string };
    if (!body.ok || !body.url) throw new Error(`apps.connections.open: ${body.error}`);

    const ws = new WebSocket(body.url);

    ws.addEventListener('message', (ev: MessageEvent) => {
        const frame = JSON.parse(String(ev.data)) as Frame;

        // Slack redelivers anything unacknowledged, so acknowledge first.
        if (frame.envelope_id) ws.send(JSON.stringify({ envelope_id: frame.envelope_id }));

        if (frame.type === 'hello') {
            console.log(`connected: app ${frame.connection_info?.app_id ?? '?'}`);
            return;
        }

        const e = frame.payload?.event;
        if (!e || e.type !== 'message' || e.subtype) return;
        // The app's own messages come back down the socket; spooling them would
        // have the agent answer itself.
        if (e.bot_id || !e.user) return;

        const entry = {
            ts: e.ts ?? String(Date.now() / 1000),
            channel: e.channel ?? '?',
            // An assistant app's DMs arrive in a thread, and a reply without
            // this lands in the channel body, where the sender never sees it.
            thread_ts: e.thread_ts ?? e.ts ?? null,
            user: e.user,
            name: label.get(e.user) ?? e.user,
            text: e.text ?? '',
        };
        appendFileSync(SPOOL, `${JSON.stringify(entry)}\n`, { mode: 0o600 });
        console.log(`spooled: ${entry.name}: ${entry.text.slice(0, 70)}`);
    });

    // Slack rotates these sockets, and the process is meant to outlive any one
    // of them, so a close is a reconnect rather than an exit.
    await new Promise<void>((resolve) => {
        ws.addEventListener('close', () => resolve());
        ws.addEventListener('error', () => resolve());
    });
}

for (;;) {
    try {
        await connect();
        console.log('socket closed; reconnecting');
    } catch (error) {
        console.log(`connect failed: ${(error as Error).message}`);
    }
    await new Promise((r) => setTimeout(r, 5000));
}
