{
  "name": "rho",
  "version": "0.1.0",
  "description": "Samuel's personal pi dotfiles: extensions, skills, prompts, and themes.",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/pi-web-access/index.ts",
      "node_modules/@ayulab/pi-rewind/index.js",
      "node_modules/context-mode/build/adapters/pi/extension.js",
      "node_modules/token-rate-pi/token-rate.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-web-access/skills",
      "node_modules/context-mode/skills"
    ],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "scripts": {
    "test": "bun test tests/",
    "postinstall": "bun tools/version-gate.mjs && bun tools/preflight.ts --install && bun tools/link-pi-packages.ts && (bun tools/bun-shebang.ts || true)",
    "bun-shebang": "bun tools/bun-shebang.ts",
    "doctor": "bun tools/version-gate.mjs && bun tools/preflight.ts",
    "typecheck": "tsc --noEmit",
    "prompt": "bun tools/prompt-explorer.ts",
    "prompt:cli": "bun tools/prompt-explorer.ts --cli",
    "prompt:preview": "bun tools/prompt-explorer.ts --preview",
    "prompt:plain": "bun tools/prompt-explorer.ts --plain",
    "prompt:full": "bun tools/prompt-full.ts",
    "prompt:full:json": "bun tools/prompt-full.ts --json",
    "unshitty": "bun tools/unshitty.ts",
    "unshitty:head": "bun tools/unshitty.ts --head",
    "init": "bun tools/init-config.ts",
    "smoke": "bun ci/smoke.ts",
    "smoke:docker": "docker build -f ci/Dockerfile -t rho-smoke . && docker run --rm rho-smoke",
    "link": "pi install -l $(pwd)",
    "link:global": "pi install $(pwd)"
  },
  "dependencies": {
    "@ayulab/pi-rewind": "^0.4.6",
    "context-mode": "^1.0.169",
    "env-paths": "^4.0.0",
    "pi-web-access": "^0.13.0",
    "smol-toml": "^1.8.0",
    "token-rate-pi": "^1.0.5"
  },
  "bundledDependencies": ["pi-web-access", "@ayulab/pi-rewind", "context-mode", "token-rate-pi"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.84.4",
    "typebox": "^1.3.7"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
